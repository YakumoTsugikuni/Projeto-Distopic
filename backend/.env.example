# Copie para .env e ajuste. As contas ficam no banco (não aqui): a primeira é
# criada na tela de entrada e as demais pelo administrador.
# DISTOPIC_PASSWORD_HASH=   (legado: a senha única antiga; na 1ª execução vira a conta "admin")

# Pastas do PC em que a Distopic pode listar, ler e criar arquivos (só contas de
# administrador usam essas ferramentas). Várias pastas: separe com ';'.
#   - A PRIMEIRA é a pasta de trabalho: caminhos relativos partem dela
#     ("src/main/App.java" -> <primeira>\src\main\App.java; pastas são criadas sozinhas).
#   - As demais são alcançadas pelo caminho completo ou começando pelo nome da pasta
#     ("Projetos/site/index.html" -> D:\Projetos\site\index.html).
#   - Tudo fora delas é recusado, e dentro delas continuam bloqueados .env, .ssh,
#     .git, AppData e arquivos de chave (.pem, .key, ...).
# Padrão: <projeto>/workspace (ou %USERPROFILE%\Distopic no aplicativo instalado).
# DISTOPIC_ALLOWED_ROOTS=C:\Users\SeuUsuario\Documents\Distopic;D:\Projetos;D:\Estudos

# Onde fica o banco de conversas (distopic.db). Padrão: %LOCALAPPDATA%\Distopic
# Não use uma pasta sincronizada (OneDrive, Dropbox): corrompe o banco.
# DISTOPIC_DATA_DIR=

# 127.0.0.1 basta para o Cloudflare Tunnel. Use 0.0.0.0 para acesso pela rede local.
# DISTOPIC_HOST=127.0.0.1
# DISTOPIC_PORT=8000

# DISTOPIC_MODEL=distopic
# DISTOPIC_OLLAMA_URL=http://localhost:11434
# DISTOPIC_NUM_CTX=8192
# DISTOPIC_KEEP_ALIVE=30m
# DISTOPIC_NUM_PREDICT=1024   (teto de tokens por resposta)
# DISTOPIC_PREWARM=1          (0 = não carregar o modelo na VRAM ao iniciar)
