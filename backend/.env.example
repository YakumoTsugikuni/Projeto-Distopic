# Copie para .env e ajuste. A senha é definida com: python -m app.set_password
# DISTOPIC_PASSWORD_HASH=   (gerado pelo comando acima)

# Pastas que a Distopic pode acessar, separadas por ';'. A primeira é a pasta de trabalho.
# Padrão: <projeto>/workspace
# DISTOPIC_ALLOWED_ROOTS=C:\Users\SeuUsuario\Documents;D:\Projetos

# Onde fica o banco de conversas (distopic.db). Padrão: %LOCALAPPDATA%\Distopic
# Não use uma pasta sincronizada (OneDrive, Dropbox): corrompe o banco.
# DISTOPIC_DATA_DIR=

# 127.0.0.1 basta para o Cloudflare Tunnel. Use 0.0.0.0 para acesso pela rede local.
# DISTOPIC_HOST=127.0.0.1
# DISTOPIC_PORT=8000

# DISTOPIC_MODEL=distopic
# DISTOPIC_OLLAMA_URL=http://localhost:11434
# DISTOPIC_NUM_CTX=8192
# DISTOPIC_KEEP_ALIVE=30m
# DISTOPIC_NUM_PREDICT=1024   (teto de tokens por resposta)
# DISTOPIC_PREWARM=1          (0 = não carregar o modelo na VRAM ao iniciar)
