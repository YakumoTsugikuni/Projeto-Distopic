{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Distopia",
  "version": "0.1.0",
  "identifier": "com.distopia.desktop",
  "build": {
    "frontendDist": "./shell"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Distopia",
        "width": 1200,
        "height": 800,
        "minWidth": 420,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/distopia-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
